/target/
**/__pycache__/
*.pyc
.venv/
node_modules/
dist/
*.so
*.pyd
*.dll
.DS_Store

# Android (Gradle/AGP build output, локальный путь к SDK, кэш Kotlin-компилятора)
/android/app/build/
/android/build/
/android/.gradle/
/android/.kotlin/
/android/local.properties
*.apk
*.aab

# Контейнеры .slr — пользовательские зашифрованные данные и тестовые
# артефакты, никогда не место в истории репозитория.
*.slr

# Личные (per-machine) настройки Claude Code — settings.json (общий) остаётся.
.claude/settings.local.json

# code-signing секреты — реальный android/release.keystore и
# android/keystore.properties сюда попадают, .example-шаблон — обычный
# .keystore/.properties, не .example, поэтому не нужен отдельный !negate.
*.pfx
*.p12
*.jks
*.keystore
/android/keystore.properties

# PyInstaller build output (Фаза 16) — dist/ уже выше, здесь — build/.
/desktop/build/

# cargo-fuzz (Фаза 17) — build output и автосгенерированный corpus/
# artifacts, не куратируемые вручную входы.
/core/fuzz/target/
/core/fuzz/corpus/
/core/fuzz/artifacts/

# AppImage (Фаза 16/17) — appimagetool (скачивается скриптом),
# промежуточный AppDir и итоговый .AppImage — всё воспроизводимо из
# scripts/build_appimage.sh, не артефакты для коммита.
/desktop/packaging/appimagetool-*.AppImage
/desktop/packaging/AppDir/
*.AppImage
