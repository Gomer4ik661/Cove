# Контейнеры .slr — пользовательские зашифрованные данные и тестовые
# артефакты, никогда не место в истории репозитория.
*.slr

# Личные (per-machine) настройки Claude Code — settings.json (общий) остаётся.
.claude/settings.local.json

# code-signing секреты — на случай, если кто-то положит их локально рядом
# с проектом вместо CI secrets (Фаза 16).
*.pfx
*.p12
*.jks
*.keystore
!android/release.keystore.example
