<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Проверка обновлений (ROADMAP.md Фаза 18) — единственная причина
         исходящих сетевых запросов из Android-приложения: GitHub Releases
         API + скачивание небольшого подписанного манифеста версии, см.
         update/UpdateChecker.kt. Сам контейнер .slr по сети никогда не
         уходит (кроме опционального Web-доступа с Desktop — это Фаза 13,
         отдельная функциональность на другой платформе). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Cove"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Cove"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Cove">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Для "открыть во внешнем приложении" (media/ExternalOpen.kt) —
             неподдерживаемые типы (pdf и т.п.) экспортируются в
             cacheDir/exports и отдаются другому приложению через
             content://, а не file:// (запрещено с API 24+ StrictMode). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.cove.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
