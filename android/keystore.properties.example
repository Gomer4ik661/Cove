# Шаблон для android/keystore.properties (реальный файл не в git — см.
# .gitignore). Фаза 16 (ROADMAP.md): подпись release-сборок.
#
# Сгенерировать свой keystore:
#   keytool -genkeypair -v -keystore android/release.keystore \
#     -alias cove-release -keyalg RSA -keysize 4096 -validity 10950
#
# storeFile — путь относительно android/ (или абсолютный).
# PKCS12-хранилища (формат по умолчанию у современного keytool) не
# поддерживают разные storePassword/keyPassword — используйте один и тот
# же пароль для обоих полей.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=cove-release
keyPassword=CHANGE_ME
